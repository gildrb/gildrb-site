// Product pages on their own hosts, and the install-only hosts of `Local` products; see
// products.ts. Deploy: `npx wrangler deploy -c worker/wrangler.jsonc`.
// eukhe.com and www.eukhe.com belong to the eukhe-site Worker (repo gildrb/eukhe-site); this one
// keeps eukhe.gildrb.com, which redirects there. porthmeus.com, www.porthmeus.com and the old
// poros.gildrb.com serve the Porthmeus installer and redirect the rest to gildrb.com/porthmeus.
{
  "name": "gildrb-products",
  "main": "products.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "routes": [
    { "pattern": "archetypon.gildrb.com", "custom_domain": true },
    { "pattern": "porthmeus.com", "custom_domain": true },
    { "pattern": "www.porthmeus.com", "custom_domain": true },
    { "pattern": "poros.gildrb.com", "custom_domain": true },
    { "pattern": "eukhe.gildrb.com", "custom_domain": true },
  ],
}
